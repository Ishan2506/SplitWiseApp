<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- app-store-connect is the destination for TestFlight builds. -->
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>G722HBHSC4</string>

	<!-- Manual: the cert and profile are imported by the workflow, so
	     Xcode must not try to fetch its own during export. -->
	<key>signingStyle</key>
	<string>manual</string>

	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<key>provisioningProfiles</key>
	<dict>
		<key>com.bondbyte.paisasplit</key>
		<string>PaisaSplit App Store</string>
	</dict>

	<key>uploadSymbols</key>
	<true/>

	<!-- Bitcode is removed in modern Xcode; keep it off explicitly. -->
	<key>compileBitcode</key>
	<false/>

	<key>destination</key>
	<string>export</string>
</dict>
</plist>
