<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- app-store-connect is the destination for TestFlight builds. -->
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>G722HBHSC4</string>

	<!-- Let Xcode manage the signing assets during export. -->
	<key>signingStyle</key>
	<string>automatic</string>

	<key>uploadSymbols</key>
	<true/>

	<!-- Bitcode is removed in modern Xcode; keep it off explicitly. -->
	<key>compileBitcode</key>
	<false/>

	<key>destination</key>
	<string>export</string>
</dict>
</plist>
